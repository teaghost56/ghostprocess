      "id": "32aa4a6e-8278-4530-9d47-0346b08555d6",
      "name": "Nettoyer la demande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// ===== Site Ghostprocess · Nettoyer la demande reçue du formulaire =====\nconst s = $('Settings').first().json;\nconst b = $input.first().json.body || {};\nconst v = (x, max = 300) => String(x ?? '').replace(/[\\u0000-\\u001f]+/g, ' ').trim().slice(0, max);\nconst esc = t => String(t).replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\n\n// Téléphone : 8 chiffres tunisiens → 216XXXXXXXX\nlet tel = v(b.telephone, 30).replace(/[^\\d+]/g, '').replace(/^\\+/, '').replace(/^00/, '');\nif (/^\\d{8}$/.test(tel)) tel = '216' + tel;\n\nconst BESOINS = { decouverte: 'Appel découverte', impayes: 'GhostCollect · impayés', 'rendez-vous': 'GhostBook Pro · rendez-vous',\n  assistant: 'GhostReception · assistant clients', voyage: 'GhostTravel · agence de voyage', emails: 'GhostMail · e-mails', pilote: 'Programme pilote', 'sur-mesure': 'Sur mesure' };\n\nconst lead = {\n  recu_le: new Date().toLocaleString('fr-FR', { timeZone: 'Africa/Tunis' }),\n  nom: v(b.nom, 120),\n  telephone: tel,\n  email: v(b.email, 160),\n  entreprise: v(b.entreprise, 160),\n  secteur: v(b.secteur, 80),\n  besoin: BESOINS[v(b.besoin)] || v(b.besoin, 80),\n  message: v(b.message, 1500),\n  consentement: v(b.consentement, 5),\n  source: v(b.source, 300),\n  page: v(b.page, 300),\n  statut: 'nouveau',\n};\n// Spam : champ piège rempli, ou nom/téléphone absents, ou liens dans le message\nconst spam = !!b.site_web || !lead.nom || tel.length < 8 || (lead.message.match(/https?:\\/\\//g) || []).length > 2;\n\nconst rows = [['Nom', lead.nom], ['Téléphone', lead.telephone ? `<a href=\"https://wa.me/${lead.telephone}\">+${lead.telephone}</a>` : ''],\n  ['E-mail', lead.email], ['Entreprise', lead.entreprise], ['Secteur', lead.secteur], ['Besoin', lead.besoin],\n  ['Message', lead.message], ['Source', lead.source], ['Reçu le', lead.recu_le]]\n  .filter(([, x]) => x).map(([k, x]) => `<tr><td style=\"padding:6px 12px 6px 0;color:#667\"><b>${k}</b></td><td style=\"padding:6px 0\">${k === 'Téléphone' ? x : esc(x)}</td></tr>`).join('');\n\nreturn [{ json: {\n  ...lead, spam,\n  email_subject: `🟢 Nouvelle demande site : ${lead.nom}${lead.entreprise ? ' (' + lead.entreprise + ')' : ''} – ${lead.besoin}`,\n  email_html: `<div style=\"font-family:Arial,sans-serif;font-size:14px\"><p>Nouvelle demande reçue depuis le site Ghostprocess.</p><table>${rows}</table><p style=\"color:#667\">À rappeler sous 24 h ouvrées. Le contact est enregistré dans l'onglet ${esc(s.sheet_tab)}.</p></div>`,\n} }];\n"
      }
    },
